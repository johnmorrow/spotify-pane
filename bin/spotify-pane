#!/usr/bin/env bash
# spotify-pane — open a Spotify now-playing pane in zterm.
#
#   spotify-pane [split_right|split_down|new_tab|new_window] [--ratio 0.35]
#   spotify-pane start | stop | status | logs
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PORT="${SPOTIFY_PANE_PORT:-8888}"
URL="http://127.0.0.1:${PORT}/"
STATE_DIR="${SPOTIFY_PANE_HOME:-$HOME/.config/spotify-pane}"
LOG="$STATE_DIR/server.log"
PIDFILE="$STATE_DIR/server.pid"
mkdir -p "$STATE_DIR"

running() { curl -fsS -m 1 "${URL}healthz" >/dev/null 2>&1; }

LABEL="dev.spotify-pane.$PORT"

start() {
  running && return 0
  command -v node >/dev/null || { echo "spotify-pane: node is not on PATH (needs Node 18+)" >&2; exit 1; }
  local major; major="$(node -p 'process.versions.node.split(".")[0]')"
  (( major >= 18 )) || { echo "spotify-pane: needs Node 18+, found $(node --version)" >&2; exit 1; }
  if [[ "$(uname)" == Darwin ]]; then
    # Run under launchd, not as a child of this shell. macOS holds the app a process
    # was started from responsible for its Apple Events; a terminal without the
    # automation entitlement (zterm today) leaves the Spotify permission prompt hanging.
    launchctl remove "$LABEL" 2>/dev/null || true
    local envs=(SPOTIFY_PANE_PORT="$PORT" SPOTIFY_PANE_HOME="$STATE_DIR")
    for v in SPOTIFY_PANE_BACKEND SPOTIFY_PANE_MOCK SPOTIFY_PANE_MOCK_NEED SPOTIFY_CLIENT_ID; do
      [[ -n "${!v:-}" ]] && envs+=("$v=${!v}")
    done
    launchctl submit -l "$LABEL" -o "$LOG" -e "$LOG" -- /usr/bin/env "${envs[@]}" "$(command -v node)" "$HERE/server.mjs"
  else
    nohup node "$HERE/server.mjs" >>"$LOG" 2>&1 &
    echo $! >"$PIDFILE"
  fi
  for _ in $(seq 1 50); do running && return 0; sleep 0.1; done
  echo "spotify-pane: the server did not come up; see $LOG" >&2
  tail -n 5 "$LOG" >&2
  exit 1
}

stop() {
  local stopped=
  if [[ "$(uname)" == Darwin ]] && launchctl remove "$LABEL" 2>/dev/null; then stopped=1; fi
  if [[ -f "$PIDFILE" ]] && kill "$(cat "$PIDFILE")" 2>/dev/null; then stopped=1; fi
  rm -f "$PIDFILE"
  [[ -n "$stopped" ]] && echo "stopped" || echo "not running"
}

case "${1:-split_right}" in
  start)  start; echo "serving $URL" ;;
  stop)   stop ;;
  status) running && echo "running on $URL" || { echo "not running"; exit 1; } ;;
  logs)   exec tail -f "$LOG" ;;
  split_right|split_down|new_tab|new_window)
    action="$1"; shift || true
    start
    args=(perform "$action" --url "$URL")
    if [[ "$action" == split_* ]]; then
      [[ "$*" == *--ratio* ]] || args+=(--ratio 0.35)
      [[ -n "${ZESTFUL_TERM_PANE_ID:-}" ]] && args+=(--target "$ZESTFUL_TERM_PANE_ID")
    fi
    exec zterm "${args[@]}" "$@"
    ;;
  -h|--help|help) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "spotify-pane: unknown command '$1' (try --help)" >&2; exit 2 ;;
esac
